# Bill2CRM Site — control-plane project
# Copy this file to .env.local and fill in the values from:
#   Supabase Dashboard -> Project Settings -> API (for the NEW "Bill2CRM Site" project,
#   not the existing Bill2CRM Web App project)

VITE_SUPABASE_URL="https://YOUR_NEW_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_NEW_PROJECT_ANON_KEY"

# Root domain this site is deployed on (used to build tenant subdomain links)
VITE_ROOT_DOMAIN="bill2crm.in"
